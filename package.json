{
  "name": "talktalk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build:plugin": "bash scripts/build-plugin-zip.sh",
    "build": "npm run build:plugin && next build",
    "start": "next start",
    "lint": "eslint",
    "smoke:gate": "node --experimental-strip-types scripts/smoke-gate.mjs",
    "smoke:seo": "node --experimental-strip-types scripts/smoke-seo-prep.mjs",
    "smoke:methode": "node --experimental-strip-types scripts/smoke-methode.mjs",
    "smoke:comparatif": "node --experimental-strip-types scripts/smoke-comparatif.mjs",
    "smoke:tarifs": "node --experimental-strip-types scripts/smoke-tarifs-alternatives.mjs",
    "smoke:talker": "node --experimental-strip-types scripts/smoke-talker-session.mjs",
    "guard:prices": "node --experimental-strip-types scripts/guards/check-prices.mjs",
    "guard:tokens": "node --experimental-strip-types scripts/guards/check-tokens.mjs",
    "guard:comments": "node scripts/guards/check-no-comments.mjs",
    "guard:forbidden": "node scripts/guards/check-forbidden.mjs",
    "guard:faq": "node scripts/guards/check-built-faq-h1.mjs",
    "guard:source": "npm run guard:prices && npm run guard:tokens && npm run guard:comments",
    "guard:built": "npm run guard:forbidden && npm run guard:faq",
    "visual": "playwright test",
    "visual:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@radix-ui/react-slot": "^1.3.3",
    "@sanity/client": "^8.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.33.0",
    "motion": "^13.1.1",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
