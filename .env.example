# Public Sanity project (dataset production is public-read).
# No API token is required for the first landing.
NEXT_PUBLIC_SANITY_PROJECT_ID=0l81z2o2
NEXT_PUBLIC_SANITY_DATASET=production

# Optional canonical URL override
# NEXT_PUBLIC_SITE_URL=https://talker.now

# Marketing demo bubble — n8n webhook (Gemini). Server proxy: POST /api/demo-chat
# Set DEMO_CHAT_WEBHOOK on Vercel Preview (not Production).
# This preview branch falls back to the talker-demo-0e81 hook if unset.
# DEMO_CHAT_WEBHOOK=
# NEXT_PUBLIC_DEMO_LLM=1

# Soft-launch password gate (set values on Vercel — never commit a real password)
# Production: SITE_GATE_ENABLED=true and SITE_PASSWORD=<secret>
# Preview: omit SITE_GATE_ENABLED (or set false) to leave the preview public to the team
# Public GTM later: SITE_GATE_ENABLED=false, then remove noindex/robots Disallow in a follow-up PR
# SITE_GATE_ENABLED=
# SITE_PASSWORD=

# X/Twitter card site handle. Leave unset until Cap'tain confirms a live handle.
# Example shape only — not a published account:
# NEXT_PUBLIC_TWITTER_SITE=@TalkerNow

# IndexNow. Key file is already public at /<key>.txt (see lib/seo/indexnow.ts).
# Submit stays OFF while the soft-gate is on (Disallow: /).
# Set these only after Cap'tain gate-off GO — do not submit from CI before that:
# INDEXNOW_KEY=<same value as public/<key>.txt>
# INDEXNOW_HOST=talker.now
# INDEXNOW_SUBMIT=true
