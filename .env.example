# Public Sanity project (dataset production is public-read).
# No API token is required for the first landing.
NEXT_PUBLIC_SANITY_PROJECT_ID=0l81z2o2
NEXT_PUBLIC_SANITY_DATASET=production

# Optional canonical URL override
# NEXT_PUBLIC_SITE_URL=https://talker.now

# Marketing demo bubble (POST /api/demo-chat) — Vercel AI Gateway.
# Preview: enable AI Gateway on the Vercel project (OIDC, no key) OR set
# AI_GATEWAY_API_KEY on the Preview environment. OPENAI_API_KEY is a
# fallback if Gateway is not configured. Without a key, the bubble shows
# the honest fallback — it does not invent replies.
# AI_GATEWAY_API_KEY=
# OPENAI_API_KEY=
# DEMO_CHAT_MODEL=openai/gpt-5.4
# NEXT_PUBLIC_DEMO_LLM=1
